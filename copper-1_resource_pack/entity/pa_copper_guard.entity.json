{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "pa:copper_guard",
      "materials": {
        "default": "goat"
      },
      "textures": {
        "default": "textures/entity/pa_mobs/copper_guard"
      },
      "geometry": {
        "default": "geometry.goat"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos_right_side = Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed * 57.3;",
          "variable.tcos_left_side = -variable.tcos_right_side;"
        ],
        "animate": [
          "walk",
          "look_at_target"
        ]
      },
      "animations": {
        "walk": "animation.goat.walk",
        "look_at_target": "animation.goat.look_at_target"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#b4682e",
        "overlay_color": "#3b2418"
      }
    }
  }
}
